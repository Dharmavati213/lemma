# amsopn (loaded by amsmath). Written for Lemma (GPL-3.0-or-later) in TeXstudio's .cwl syntax,
# because data/raw/cwl lacks this file.

\operatorname{name}#m
\operatorname*{name}#m
\DeclareMathOperator{cmd}{text}#d
\DeclareMathOperator*{cmd}{text}#d
\injlim#m
\projlim#m
\varinjlim#m
\varprojlim#m
\varliminf#m
\varlimsup#m
