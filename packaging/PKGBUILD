# Lemma for Arch Linux, built from the local repository this file lives in (see README).
pkgname=lemma
pkgver=0.2.0
pkgrel=1
pkgdesc="LaTeX editor that shows an AI agent's edits inline for review (GTK 4)"
arch=('x86_64')
# Rust crates such as ring compile C code; makepkg's GCC LTO flags would turn those objects into
# LTO bitcode that Rust's linker cannot read.
# The binaries are stripped by Cargo's release profile: no -debug package.
options=('!lto' '!debug')
license=('GPL-3.0-or-later')
depends=(
  'cairo' 'gcc-libs' 'glib2' 'glibc' 'graphene' 'gtk4' 'gtksourceview5' 'libadwaita'
  'libspelling' 'libsynctex' 'pango' 'poppler-glib'
)
makedepends=('cargo')
optdepends=(
  'texlive-binextra: latexmk (builds) and chktex (lint)'
  'texlive-latexextra: the usual LaTeX packages'
  'hunspell-en_us: English spell checking'
  'nodejs: the Claude Code agent (its ACP adapter)'
  'npm: installing the agent adapter from the agent pane'
  'git: the git gutter'
)
# No source array: build() uses the checkout around this directory as it is.
_repo="$(realpath "$startdir/..")"

prepare() {
  cd "$_repo"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_repo"
  export RUSTUP_TOOLCHAIN=stable
  # The build stays in makepkg's $srcdir; the repository's own target/ is not touched.
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --release --locked -p lemma-app -p lemma-mcp
}

check() {
  "$srcdir/target/release/lemma" --version
}

package() {
  cd "$_repo"
  # lemma finds lemma-mcp next to itself.
  install -Dm755 "$srcdir/target/release/lemma" "$pkgdir/usr/bin/lemma"
  install -Dm755 "$srcdir/target/release/lemma-mcp" "$pkgdir/usr/bin/lemma-mcp"

  install -Dm644 packaging/io.github.lemma_editor.Lemma.desktop \
    "$pkgdir/usr/share/applications/io.github.lemma_editor.Lemma.desktop"
  install -Dm644 packaging/io.github.lemma_editor.Lemma.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.lemma_editor.Lemma.svg"

  # The defaults built into lemma, as examples for ~/.config/lemma/.
  install -Dm644 -t "$pkgdir/usr/share/lemma" data/snippets.default.toml data/prompts.default.toml
  if [ -d data/templates ]; then
    cp -r --no-preserve=ownership data/templates "$pkgdir/usr/share/lemma/templates"
    chmod -R u=rwX,go=rX "$pkgdir/usr/share/lemma/templates"
  fi

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
